# ==============================================================
# ThreatView Backend Configuration
# ==============================================================

# Application Environment: development, testing, production
APP_ENV=development
APP_NAME=ThreatView
DEBUG=True
API_PREFIX=/api

# Server Binding
HOST=127.0.0.1
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threatview

# Secret Key for JWT Token Generation and Auth
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Threat Feed Credentials
OTX_API_KEY=
URLHAUS_API_KEY=

# Ingestion Settings
INGESTION_INTERVAL_MINUTES=60
MAX_INDICATORS_PER_FETCH=500
